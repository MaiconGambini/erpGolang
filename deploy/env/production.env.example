# Example only. Copy to a protected real env file and replace every secret before production use.
APP_ENV=production
HTTP_ADDR=:8080
DATABASE_URL=postgres://goerp:change-me@postgres:5432/goerp?sslmode=disable
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=https://example.com
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
BCRYPT_COST=12
POSTGRES_DB=goerp
POSTGRES_USER=goerp
POSTGRES_PASSWORD=change-me
GOERP_DOMAIN=example.com
