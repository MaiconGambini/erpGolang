FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/goerp-migrate ./cmd/migrate

FROM alpine:3.20

RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/goerp-migrate /goerp-migrate
COPY migrations /migrations

ENV MIGRATIONS_DIR=/migrations
ENTRYPOINT ["/goerp-migrate"]
