FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/goerp-api ./cmd/api
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/goerp-migrate ./cmd/migrate

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/goerp-api /goerp-api
COPY --from=build /out/goerp-migrate /goerp-migrate
COPY migrations /migrations

ENV MIGRATIONS_DIR=/migrations
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/goerp-api"]
